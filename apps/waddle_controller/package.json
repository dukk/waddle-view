{
  "name": "waddle_controller",
  "private": true,
  "version": "1.0.0-alpha2",
  "type": "module",
  "engines": {
    "node": "^22.0.0 <23"
  },
  "scripts": {
    "postinstall": "node tool/ensure-node-tls-deps.mjs && node tool/rebuild-native-modules.mjs",
    "dev": "concurrently -k -n spa,bff -c blue,magenta \"vite\" \"npm run dev:server\"",
    "dev:spa": "vite",
    "dev:server": "node tool/ensure-node-tls-deps.mjs && tsx watch --ignore ../../packages/waddle_node_tls/node_modules server/src/index.ts",
    "generate:about": "node tool/generate_about_manifest.mjs",
    "build": "npm run generate:about && tsc -b && vite build",
    "build:server": "npm run generate:about && tsc -p server/tsconfig.json && node -e \"const fs=require('fs');const path=require('path');const src='server/src/db/migrations';const dest='server/dist/db/migrations';fs.cpSync(src,dest,{recursive:true});\"",
    "db:migrate-to-postgres": "tsx server/src/tools/migrate_sqlite_to_postgres.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "node tool/coverage_check.mjs --min=80 --target=90",
    "docker:build": "docker build -f Dockerfile -t waddle-controller ../..",
    "docker:run": "docker run --rm -p 8443:443 -v waddle-controller-data:/var/lib/waddle-controller waddle-controller",
    "docker:up": "npm run docker:build && npm run docker:run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hono/node-server": "^2.0.10",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@rjsf/core": "^6.7.0",
    "@rjsf/mui": "^6.7.0",
    "@rjsf/utils": "^6.7.0",
    "@rjsf/validator-ajv8": "^6.7.0",
    "@waddle/node-tls": "file:../../packages/waddle_node_tls",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.31",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.10"
  }
}
